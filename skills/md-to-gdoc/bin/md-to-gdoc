#!/usr/bin/env bash
#
# md-to-gdoc — convert a local markdown file to a Google Doc.
#
# Subcommands:
#   auth                    one-time OAuth bootstrap (opens browser)
#   upload <file.md>        create a new Doc (or update existing if file has gdoc-id in frontmatter)
#   status                  show config + token state
#   help                    show usage
#
# Deps: bash, curl, jq, openssl, python3 (all preinstalled on macOS).
#
# Config: ~/.config/md-to-gdoc/
#   client.json   user-supplied GCP Desktop OAuth client (see README.md for setup)
#   token.json    refresh + access tokens (written by `auth`, read by `upload`)

set -euo pipefail

# --- Paths ---------------------------------------------------------------------

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LISTENER_PY="$SKILL_DIR/bin/_auth_listener.py"
CONFIG_DIR="${MD_TO_GDOC_CONFIG_DIR:-$HOME/.config/md-to-gdoc}"
CLIENT_FILE="$CONFIG_DIR/client.json"
TOKEN_FILE="$CONFIG_DIR/token.json"

SCOPE="https://www.googleapis.com/auth/drive.file"
AUTH_URI="https://accounts.google.com/o/oauth2/v2/auth"
TOKEN_URI="https://oauth2.googleapis.com/token"
UPLOAD_URI="https://www.googleapis.com/upload/drive/v3/files"

# --- Helpers -------------------------------------------------------------------

die()  { printf 'md-to-gdoc: error: %s\n' "$*" >&2; exit 1; }
warn() { printf 'md-to-gdoc: %s\n' "$*" >&2; }
info() { printf 'md-to-gdoc: %s\n' "$*" >&2; }

require_cmd() {
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "required command '$c' not found in PATH"
  done
}

ensure_config_dir() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
}

ensure_client_file() {
  [[ -f "$CLIENT_FILE" ]] || die "no client.json at $CLIENT_FILE — see the skill's README for GCP setup steps"
}

ensure_token_file() {
  [[ -f "$TOKEN_FILE" ]] || die "no token.json at $TOKEN_FILE — run \`md-to-gdoc auth\` first"
}

# base64url encode (no padding) — read from stdin
b64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

# Read JSON field via jq (fail loud if missing)
jq_field() {
  local file="$1" field="$2"
  local val
  val=$(jq -r --arg f "$field" '.[$f] // .installed[$f] // .web[$f] // empty' "$file") || die "jq failed on $file"
  [[ -n "$val" ]] || die "missing field '$field' in $file"
  printf '%s' "$val"
}

# --- Frontmatter ---------------------------------------------------------------
#
# YAML-ish frontmatter is the block between two lines that contain only "---" at
# the very start of the file. We don't fully parse YAML — only flat "key: value"
# lines. That's enough for tracking gdoc-id and for round-tripping any other keys
# the user might have (title, date, etc.).

# Print just the frontmatter body (between the --- fences), without the fences.
# Empty output means no frontmatter present.
extract_frontmatter() {
  awk '
    NR==1 && /^---[[:space:]]*$/ { in_fm=1; next }
    in_fm && /^---[[:space:]]*$/ { exit }
    in_fm { print }
  ' "$1"
}

# Print the markdown body (everything after the closing --- fence, OR the whole
# file if there is no frontmatter).
extract_body() {
  awk '
    BEGIN { state="probe" }
    state=="probe" {
      if (NR==1 && /^---[[:space:]]*$/) { state="fm"; next }
      else                                { state="body" }
    }
    state=="fm" {
      if (/^---[[:space:]]*$/) { state="body"; next }
      next
    }
    state=="body" { print }
  ' "$1"
}

# Extract the first H1 heading from a markdown file's body and return it as a
# plain string (with the most common inline markdown stripped). Empty output
# if there is no H1.
first_h1() {
  local file="$1"
  extract_body "$file" \
    | awk '
        /^#[[:space:]]+/ {
          sub(/^#+[[:space:]]+/, "")
          sub(/[[:space:]]+#+[[:space:]]*$/, "")
          print
          exit
        }
      ' \
    | sed -E '
        s/!\[([^]]*)\]\([^)]+\)/\1/g
        s/\[([^]]+)\]\([^)]+\)/\1/g
        s/\*\*([^*]+)\*\*/\1/g
        s/__([^_]+)__/\1/g
        s/\*([^*]+)\*/\1/g
        s/_([^_]+)_/\1/g
        s/`([^`]+)`/\1/g
      '
}

# Read a flat key from a frontmatter block (passed on stdin).
# Uses only POSIX awk (BSD awk on macOS lacks the 3-arg match() form).
fm_get() {
  local key="$1"
  awk -v k="$key" '
    {
      sub(/[[:space:]]+$/, "")
      colon = index($0, ":")
      if (colon > 0) {
        rkey = substr($0, 1, colon - 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", rkey)
        if (rkey == k) {
          rval = substr($0, colon + 1)
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", rval)
          print rval
          exit
        }
      }
    }
  '
}

# Set/replace key in a markdown file's frontmatter. If the file has no frontmatter,
# prepend one with just this key. Writes via temp + atomic rename.
fm_set() {
  local file="$1" key="$2" value="$3"
  local tmp; tmp="$(mktemp "${TMPDIR:-/tmp}/md-to-gdoc.XXXXXX")"
  trap 'rm -f "$tmp"' EXIT

  local has_fm
  has_fm=$(awk 'NR==1 && /^---[[:space:]]*$/ {print "yes"; exit} {print "no"; exit}' "$file")

  if [[ "$has_fm" == "yes" ]]; then
    awk -v k="$key" -v v="$value" '
      BEGIN { state="open"; written=0 }
      state=="open" && NR==1 && /^---[[:space:]]*$/ { print; state="fm"; next }
      state=="fm" && /^---[[:space:]]*$/ {
        if (!written) { print k ": " v; written=1 }
        print; state="body"; next
      }
      state=="fm" {
        line = $0
        sub(/[[:space:]]+$/, "", line)
        colon = index(line, ":")
        rkey = ""
        if (colon > 0) {
          rkey = substr(line, 1, colon - 1)
          gsub(/^[[:space:]]+|[[:space:]]+$/, "", rkey)
        }
        if (rkey == k) {
          if (!written) { print k ": " v; written=1 }
          next
        }
        print; next
      }
      { print }
    ' "$file" > "$tmp"
  else
    {
      printf -- '---\n'
      printf '%s: %s\n' "$key" "$value"
      printf -- '---\n\n'
      cat "$file"
    } > "$tmp"
  fi

  mv "$tmp" "$file"
  trap - EXIT
}

# --- OAuth: token management ---------------------------------------------------

# Returns a fresh access token on stdout. Refreshes if the cached one is within
# 60s of expiry. Updates token.json with the new access_token + expiry.
get_access_token() {
  ensure_token_file
  local now; now=$(date +%s)
  local access expires_at refresh
  access=$(jq -r '.access_token // empty' "$TOKEN_FILE")
  expires_at=$(jq -r '.expires_at // 0' "$TOKEN_FILE")
  refresh=$(jq -r '.refresh_token // empty' "$TOKEN_FILE")

  if [[ -n "$access" && "$expires_at" -gt $((now + 60)) ]]; then
    printf '%s' "$access"
    return 0
  fi

  [[ -n "$refresh" ]] || die "no refresh_token in $TOKEN_FILE — run \`md-to-gdoc auth\` again"

  local cid csec
  cid=$(jq_field "$CLIENT_FILE" client_id)
  csec=$(jq_field "$CLIENT_FILE" client_secret)

  local resp
  resp=$(curl -sS --fail-with-body -X POST "$TOKEN_URI" \
    --data-urlencode "client_id=$cid" \
    --data-urlencode "client_secret=$csec" \
    --data-urlencode "refresh_token=$refresh" \
    --data-urlencode "grant_type=refresh_token") || die "token refresh failed: $resp"

  local new_access new_exp
  new_access=$(printf '%s' "$resp" | jq -r '.access_token // empty')
  new_exp=$(printf '%s' "$resp" | jq -r '.expires_in // 0')
  [[ -n "$new_access" ]] || die "token refresh returned no access_token: $resp"

  local new_exp_at=$((now + new_exp))
  jq --arg a "$new_access" --argjson e "$new_exp_at" \
    '.access_token = $a | .expires_at = $e' "$TOKEN_FILE" > "$TOKEN_FILE.tmp"
  mv "$TOKEN_FILE.tmp" "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"

  printf '%s' "$new_access"
}

# --- Subcommand: auth ----------------------------------------------------------

cmd_auth() {
  require_cmd curl jq openssl python3 base64 sed awk
  ensure_config_dir
  ensure_client_file

  local cid csec
  cid=$(jq_field "$CLIENT_FILE" client_id)
  csec=$(jq_field "$CLIENT_FILE" client_secret)

  # PKCE
  local verifier challenge
  verifier=$(openssl rand 48 | b64url)
  challenge=$(printf '%s' "$verifier" | openssl dgst -sha256 -binary | b64url)
  local state; state=$(openssl rand -hex 16)

  # Start one-shot listener; capture its assigned port via stderr.
  local listener_stderr; listener_stderr=$(mktemp "${TMPDIR:-/tmp}/md-to-gdoc.lst.XXXXXX")
  local listener_stdout; listener_stdout=$(mktemp "${TMPDIR:-/tmp}/md-to-gdoc.out.XXXXXX")
  python3 "$LISTENER_PY" >"$listener_stdout" 2>"$listener_stderr" &
  local listener_pid=$!
  trap 'kill "$listener_pid" 2>/dev/null || true; rm -f "$listener_stderr" "$listener_stdout"' EXIT

  # Wait briefly for the listener to bind.
  local port=""
  for _ in $(seq 1 50); do
    if grep -q '^PORT=' "$listener_stderr" 2>/dev/null; then
      port=$(awk -F= '/^PORT=/ {print $2; exit}' "$listener_stderr")
      break
    fi
    sleep 0.05
  done
  [[ -n "$port" ]] || die "loopback listener failed to start"

  local redirect="http://127.0.0.1:$port"
  local url="${AUTH_URI}?response_type=code"
  url+="&client_id=$(printf %s "$cid" | jq -sRr @uri)"
  url+="&redirect_uri=$(printf %s "$redirect" | jq -sRr @uri)"
  url+="&scope=$(printf %s "$SCOPE" | jq -sRr @uri)"
  url+="&code_challenge=$(printf %s "$challenge" | jq -sRr @uri)"
  url+="&code_challenge_method=S256"
  url+="&state=$(printf %s "$state" | jq -sRr @uri)"
  url+="&access_type=offline&prompt=consent"

  info "opening browser for Google consent..."
  info "(if it doesn't open, paste this URL manually: $url)"
  if command -v open >/dev/null 2>&1; then
    open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$url"
  fi

  # Wait for listener to capture the code.
  wait "$listener_pid" 2>/dev/null || true
  trap - EXIT

  local code=""
  code=$(awk -F= '/^CODE=/ {print substr($0, 6); exit}' "$listener_stdout" || true)
  if [[ -z "$code" ]]; then
    local err; err=$(awk -F= '/^ERROR=/ {print substr($0, 7); exit}' "$listener_stdout" || true)
    rm -f "$listener_stderr" "$listener_stdout"
    die "OAuth callback returned no code (${err:-unknown})"
  fi
  rm -f "$listener_stderr" "$listener_stdout"

  # Exchange code -> tokens.
  local resp
  resp=$(curl -sS --fail-with-body -X POST "$TOKEN_URI" \
    --data-urlencode "client_id=$cid" \
    --data-urlencode "client_secret=$csec" \
    --data-urlencode "code=$code" \
    --data-urlencode "code_verifier=$verifier" \
    --data-urlencode "redirect_uri=$redirect" \
    --data-urlencode "grant_type=authorization_code") || die "token exchange failed: $resp"

  local access refresh expires_in
  access=$(printf '%s' "$resp" | jq -r '.access_token // empty')
  refresh=$(printf '%s' "$resp" | jq -r '.refresh_token // empty')
  expires_in=$(printf '%s' "$resp" | jq -r '.expires_in // 0')
  [[ -n "$access" ]] || die "token exchange returned no access_token: $resp"
  [[ -n "$refresh" ]] || die "no refresh_token returned — re-run \`md-to-gdoc auth\` (consent screen must include access_type=offline + prompt=consent)"

  local now; now=$(date +%s)
  local exp_at=$((now + expires_in))
  jq -n --arg a "$access" --arg r "$refresh" --argjson e "$exp_at" \
    '{access_token: $a, refresh_token: $r, expires_at: $e}' > "$TOKEN_FILE"
  chmod 600 "$TOKEN_FILE"

  info "authorized — tokens saved to $TOKEN_FILE"
}

# --- Subcommand: upload --------------------------------------------------------

cmd_upload() {
  require_cmd curl jq awk
  local file="${1:-}"
  [[ -n "$file" ]] || die "usage: md-to-gdoc upload <file.md>"
  [[ -f "$file" ]] || die "no such file: $file"

  ensure_config_dir
  ensure_client_file

  local fm gdoc_id title
  fm=$(extract_frontmatter "$file")
  gdoc_id=$(printf '%s\n' "$fm" | fm_get gdoc-id || true)
  # Title precedence: frontmatter `title:` → first H1 in body → filename.
  title=$(printf '%s\n' "$fm" | fm_get title || true)
  if [[ -z "$title" ]]; then
    title="$(first_h1 "$file")"
  fi
  if [[ -z "$title" ]]; then
    title="$(basename "$file" .md)"
  fi

  local body_file; body_file=$(mktemp "${TMPDIR:-/tmp}/md-to-gdoc.body.XXXXXX")
  local multipart; multipart=$(mktemp "${TMPDIR:-/tmp}/md-to-gdoc.mp.XXXXXX")
  trap 'rm -f "$body_file" "$multipart"' EXIT
  extract_body "$file" > "$body_file"

  local boundary; boundary="mdtogdoc_$(openssl rand -hex 12)"
  local metadata
  if [[ -n "$gdoc_id" ]]; then
    # update: don't reset mimeType (already a Doc); update name only.
    metadata=$(jq -nc --arg n "$title" '{name: $n}')
  else
    metadata=$(jq -nc --arg n "$title" '{name: $n, mimeType: "application/vnd.google-apps.document"}')
  fi

  {
    printf -- '--%s\r\n' "$boundary"
    printf 'Content-Type: application/json; charset=UTF-8\r\n\r\n'
    printf '%s\r\n' "$metadata"
    printf -- '--%s\r\n' "$boundary"
    printf 'Content-Type: text/markdown; charset=UTF-8\r\n\r\n'
    cat "$body_file"
    printf '\r\n--%s--\r\n' "$boundary"
  } > "$multipart"

  local access; access=$(get_access_token)

  local resp http_status
  if [[ -n "$gdoc_id" ]]; then
    info "updating existing Doc $gdoc_id..."
    resp=$(curl -sS -X PATCH \
      -H "Authorization: Bearer $access" \
      -H "Content-Type: multipart/related; boundary=$boundary" \
      --data-binary "@$multipart" \
      "${UPLOAD_URI}/${gdoc_id}?uploadType=multipart&fields=id,name,webViewLink") || die "upload failed (network)"
  else
    info "creating new Doc..."
    resp=$(curl -sS -X POST \
      -H "Authorization: Bearer $access" \
      -H "Content-Type: multipart/related; boundary=$boundary" \
      --data-binary "@$multipart" \
      "${UPLOAD_URI}?uploadType=multipart&fields=id,name,webViewLink") || die "upload failed (network)"
  fi
  rm -f "$body_file" "$multipart"
  trap - EXIT

  # API errors are returned as JSON with an "error" key, even with HTTP 200.
  if printf '%s' "$resp" | jq -e '.error' >/dev/null 2>&1; then
    die "Drive API error: $(printf '%s' "$resp" | jq -c '.error')"
  fi

  local new_id link
  new_id=$(printf '%s' "$resp" | jq -r '.id // empty')
  link=$(printf '%s' "$resp" | jq -r '.webViewLink // empty')
  [[ -n "$new_id" ]] || die "no id in response: $resp"

  if [[ -z "$gdoc_id" ]]; then
    fm_set "$file" gdoc-id "$new_id"
    info "wrote gdoc-id to frontmatter of $file"
  fi

  printf '%s\n' "$link"
}

# --- Subcommand: status --------------------------------------------------------

cmd_status() {
  printf 'config dir:     %s\n' "$CONFIG_DIR"
  if [[ -f "$CLIENT_FILE" ]]; then
    local cid; cid=$(jq -r '.installed.client_id // .web.client_id // .client_id // "?"' "$CLIENT_FILE" 2>/dev/null || echo "?")
    printf 'client.json:    present (client_id: %s)\n' "${cid:0:12}…"
  else
    printf 'client.json:    MISSING — see README for GCP setup\n'
  fi
  if [[ -f "$TOKEN_FILE" ]]; then
    local exp_at; exp_at=$(jq -r '.expires_at // 0' "$TOKEN_FILE")
    local now; now=$(date +%s)
    if [[ "$exp_at" -gt "$now" ]]; then
      printf 'token.json:     present (access token valid for %ds)\n' $((exp_at - now))
    else
      printf 'token.json:     present (access token expired — will refresh on next upload)\n'
    fi
  else
    printf 'token.json:     MISSING — run `md-to-gdoc auth`\n'
  fi
}

# --- Usage ---------------------------------------------------------------------

cmd_help() {
  cat <<'EOF'
md-to-gdoc — convert a local markdown file to a Google Doc.

Usage:
  md-to-gdoc auth                one-time OAuth bootstrap (opens browser)
  md-to-gdoc upload <file.md>    create or update a Google Doc
  md-to-gdoc status              show config + token state
  md-to-gdoc help                this help

First time setup: see the skill's README for the 5-minute GCP project setup.
After that:
  md-to-gdoc auth                                # once per machine
  md-to-gdoc upload docs/research/foo.md         # creates the Doc; writes gdoc-id
                                                 # back to the file's frontmatter
  md-to-gdoc upload docs/research/foo.md         # subsequent runs update the
                                                 # same Doc (same URL)

Config dir:   $MD_TO_GDOC_CONFIG_DIR  (default: ~/.config/md-to-gdoc)
EOF
}

# --- Dispatch ------------------------------------------------------------------

main() {
  local sub="${1:-help}"
  shift || true
  case "$sub" in
    auth)             cmd_auth "$@" ;;
    upload)           cmd_upload "$@" ;;
    status)           cmd_status "$@" ;;
    help|-h|--help)   cmd_help ;;
    *)                cmd_help; die "unknown subcommand: $sub" ;;
  esac
}

main "$@"
